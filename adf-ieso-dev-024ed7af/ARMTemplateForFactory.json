{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ieso-dev-024ed7af"
		},
		"ls_ieso_ingest_function_properties_typeProperties_functionAppUrl": {
			"type": "string",
			"defaultValue": "https://func-ieso-ingest-dev-024ed7af.azurewebsites.net"
		},
		"ls_ieso_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-ieso-dev-024ed7af.vault.azure.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ieso_datacollect')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "act_collect_rt_lmp",
						"type": "AzureFunctionActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:10:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"functionName": "collect_ieso",
							"body": {
								"value": "@concat('{\"source\":\"rt_lmp\",\"report_file\":\"', pipeline().parameters.report_file, '\"}')",
								"type": "Expression"
							},
							"headers": {
								"Content-Type": "application/json",
								"x-adf-run-id": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"method": "POST"
						},
						"linkedServiceName": {
							"referenceName": "ls_ieso_ingest_function",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "if_rt_lmp_accepted",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "act_collect_rt_lmp",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(activity('act_collect_rt_lmp').output.validation_status, 'accepted')",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "fail_rt_lmp_not_accepted",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "IESO real time LMP ingestion did not return an accepted status.",
										"errorCode": "IESO_INGEST_NOT_ACCEPTED"
									}
								}
							]
						}
					},
					{
						"name": "act_collect_rt_totals",
						"type": "AzureFunctionActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.10:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"functionName": "collect_ieso",
							"body": {
								"value": "@concat('{\"source\":\"rt_totals\",\"report_file\":\"', pipeline().parameters.totals_report_file, '\"}')",
								"type": "Expression"
							},
							"headers": {
								"Content-Type": "application/json",
								"x-adf-run-id": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"method": "POST"
						},
						"linkedServiceName": {
							"referenceName": "ls_ieso_ingest_function",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "if_rt_totals_accepted",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "act_collect_rt_totals",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(activity('act_collect_rt_totals').output.validation_status, 'accepted')",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "fail_rt_totals_not_accepted",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "IESO Real-Time Totals CSV/XML pair was not accepted. Inspect act_collect_rt_totals output and ingestion records.",
										"errorCode": "IESO_TOTALS_NOT_ACCEPTED"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"report_file": {
						"type": "string",
						"defaultValue": "PUB_RealtimeEnergyLMP.csv"
					},
					"totals_report_file": {
						"type": "string",
						"defaultValue": "PUB_RealtimeTotals.csv"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_ieso_ingest_function')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_ieso_ingest_function')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureFunction",
				"typeProperties": {
					"functionAppUrl": "[parameters('ls_ieso_ingest_function_properties_typeProperties_functionAppUrl')]",
					"authentication": "Anonymous",
					"functionKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_ieso_keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "ieso-ingest-function-key"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_ieso_keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_ieso_keyvault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('ls_ieso_keyvault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		}
	]
}