      },
      {
        "name": "Metrics",
        "columns": [
          {
            "name": "anchor",
            "dataType": "int64",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "6b696870-c9a9-4364-9c26-5a213fb9af80",
            "sourceColumn": "anchor",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "a1e98c1c-5364-472b-81ef-d3a70cb2f92b",
        "measures": [
          {
            "name": "Selected Day",
            "expression": "COALESCE(SELECTEDVALUE('Calendar'[delivery_date]),MAXX(ALL('Calendar'),'Calendar'[delivery_date]))",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "5e6737fe-a6bd-4dcf-8df6-ea249843c812"
          },
          {
            "name": "Selected Week",
            "expression": "COALESCE(SELECTEDVALUE('Calendar'[week_start]),MAXX(ALL('Calendar'),'Calendar'[week_start]))",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "141e0ce7-9479-4a9d-885a-0e1e9cb4bf57"
          },
          {
            "name": "Elapsed Week Hours",
            "expression": "VAR w=[Selected Week] VAR marketNow=UTCNOW()-5/24 RETURN MAX(0,MIN(168,INT((marketNow-w)*24)))",
            "formatString": "#,0",
            "lineageTag": "446e1100-f907-4a4f-a903-94cead432299"
          },
          {
            "name": "Data State",
            "expression": "IF(COUNTROWS(ALL(MarketIntervals))=0,\"NO MARKET MEASUREMENTS LOADED\", \"Imported observations - inspect coverage and timestamps\")",
            "lineageTag": "a01f9120-f182-4365-9145-b2841bc104dd"
          },
          {
            "name": "Day Label",
            "expression": "\"Selected delivery day: \" & FORMAT([Selected Day],\"yyyy-mm-dd\") & \" | IESO fixed UTC-05 reporting dates\"",
            "lineageTag": "bbdeda8c-a2d5-4690-988f-2017c3e631d0"
          },
          {
            "name": "Week Label",
            "expression": [
              "VAR w=[Selected Week] VAR todayMarket=INT(UTCNOW()-5/24)",
              "      VAR thisMonday=todayMarket-WEEKDAY(todayMarket,2)+1",
              "      RETURN IF(w=thisMonday,\"This week: \",IF(w<thisMonday,\"Historical week: \",\"Future week: \"))",
              "      & FORMAT(w,\"yyyy-mm-dd\") & \" to \" & FORMAT(w+6,\"yyyy-mm-dd\")",
              "      & \" | elapsed complete hours: \" & FORMAT([Elapsed Week Hours],\"0\") & \"/168\""
            ],
            "lineageTag": "5559de05-c8f5-4777-8788-ee3d05917427"
          },
          {
            "name": "Comparison Label",
            "expression": [
              "VAR w=[Selected Week] VAR hours=[Elapsed Week Hours]",
              "      RETURN \"Aligned periods [start, end): \" & FORMAT(w,\"yyyy-mm-dd HH:mm\") & \" to \"",
              "      & FORMAT(w+hours/24,\"yyyy-mm-dd HH:mm\") & \" versus \" & FORMAT(w-7,\"yyyy-mm-dd HH:mm\")",
              "      & \" to \" & FORMAT(w-7+hours/24,\"yyyy-mm-dd HH:mm\") & \" | IESO reporting clock\""
            ],
            "lineageTag": "7f8caf92-f0dc-433d-9a4a-e1f7720d0431"
          },
          {
            "name": "Last Covered Market UTC",
            "expression": "MAXX(FILTER(ALL(MarketIntervals),NOT ISBLANK(MarketIntervals[price_cad_mwh])),MarketIntervals[interval_end_utc])",
            "formatString": "yyyy-mm-dd HH:mm",
            "lineageTag": "aa20d3e8-1aec-49ae-b4a5-653b5ef4d47f"
          },
          {
            "name": "Last Covered Demand UTC",
            "expression": "MAXX(FILTER(ALL(MarketIntervals),NOT ISBLANK(MarketIntervals[demand_mw])),MarketIntervals[interval_end_utc])",
            "formatString": "yyyy-mm-dd HH:mm",
            "lineageTag": "54456904-f780-49ed-9157-ae3915d61169"
          },
          {
            "name": "Last Covered DA UTC",
            "expression": "MAXX(FILTER(ALL(PriceHourly),NOT ISBLANK(PriceHourly[day_ahead_cad_mwh])),PriceHourly[delivery_date]+PriceHourly[delivery_hour]/24+5/24)",
            "formatString": "yyyy-mm-dd HH:mm",
            "lineageTag": "3b639dd6-a5d3-497d-ae11-4602d3bd5310"
          },
          {
            "name": "Last Generator Report UTC",
            "expression": "MAXX(ALL(GeneratorHourly),GeneratorHourly[delivery_date]+GeneratorHourly[delivery_hour]/24+5/24)",
            "formatString": "yyyy-mm-dd HH:mm",
            "lineageTag": "02d1d02e-95db-4870-8e72-e20e41487fe5"
          },
          {
            "name": "Last Generator Output UTC",
            "expression": "MAXX(FILTER(ALL(GeneratorHourly),NOT ISBLANK(GeneratorHourly[output_mw])),GeneratorHourly[delivery_date]+GeneratorHourly[delivery_hour]/24+5/24)",
            "formatString": "yyyy-mm-dd HH:mm",
            "lineageTag": "674c6665-9cf5-487e-b0c2-2bc9ae2629ef"
          },
          {
            "name": "Import Refresh UTC",
            "expression": "MAX(RefreshInfo[refresh_utc])",
            "formatString": "yyyy-mm-dd HH:mm:ss",
            "lineageTag": "b8913d5c-5cfd-49c4-9a5e-bc68c89ed9ca"
          },
          {
            "name": "Snapshot Export UTC",
            "expression": "MAX(Snapshot[exported_utc])",
            "formatString": "yyyy-mm-dd HH:mm:ss",
            "lineageTag": "6bc20c40-23cd-4aa8-9960-fbec788877c2"
          },
          {
            "name": "Snapshot State",
            "expression": "SELECTEDVALUE(Snapshot[source_state],\"No snapshot metadata\")",
            "lineageTag": "e964eeeb-6610-451f-b236-dec2e9efe49a"
          },
          {
            "name": "Day Price CAD per MWh",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(AVERAGE(MarketIntervals[price_cad_mwh]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "b7084784-d4ca-4a77-a2b9-2c3d96c5afea"
          },
          {
            "name": "Day Demand MW",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(AVERAGE(MarketIntervals[demand_mw]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "bfa2ab11-83a2-4b13-8ff9-bc17a6cb9a94"
          },
          {
            "name": "Day Demand Peak MW",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(MAX(MarketIntervals[demand_mw]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "72ba3fb0-bcc8-45fd-95cb-cc6b2bb0e419"
          },
          {
            "name": "Day Minimum Price",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(MIN(MarketIntervals[price_cad_mwh]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "16928eb9-14e3-4bea-8512-281b19c40ab3"
          },
          {
            "name": "Day Maximum Price",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(MAX(MarketIntervals[price_cad_mwh]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "fd5e4b8d-4b8d-4c19-a7df-8a6cad295ea2"
          },
          {
            "name": "Day Price Observations",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(COUNT(MarketIntervals[price_cad_mwh]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0",
            "lineageTag": "91cc44f1-11a9-49cc-bd34-a7275da4b4a5"
          },
          {
            "name": "Day Demand Observations",
            "displayFolder": "Selected day",
            "expression": "VAR d=[Selected Day] RETURN CALCULATE(COUNT(MarketIntervals[demand_mw]),KEEPFILTERS(MarketIntervals[delivery_date]=d))",
            "formatString": "#,0",
            "lineageTag": "f0926d33-33c7-489e-8448-55ec82ddbb44"
          },
          {
            "name": "Day Negative Price",
            "displayFolder": "Selected day",
            "expression": [
              "VAR d=[Selected Day] VAR p=AVERAGE(MarketIntervals[price_cad_mwh])",
              "      RETURN IF(SELECTEDVALUE(MarketIntervals[delivery_date])=d && p<0,p)"
            ],
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "8ece37b4-7226-4cb8-82d3-2304a6173013"
          },
          {
            "name": "Day Price Coverage",
            "displayFolder": "Selected day",
            "expression": "DIVIDE([Day Price Observations],288)",
            "formatString": "0.0%",
            "lineageTag": "c98270c9-2b9f-4c7e-ac08-3a657aec564d"
          },
          {
            "name": "Day Demand Coverage",
            "displayFolder": "Selected day",
            "expression": "DIVIDE([Day Demand Observations],288)",
            "formatString": "0.0%",
            "lineageTag": "2f482521-9cf3-4896-ba1b-6fabffd1bffb"
          },
          {
            "name": "Week Daily Price",
            "displayFolder": "Weekly summary",
            "expression": [
              "VAR w=[Selected Week] VAR cap=[Elapsed Week Hours]*12",
              "      VAR dow=SELECTEDVALUE('Calendar'[weekday_order])",
              "      VAR observations=FILTER(ALL(MarketIntervals),MarketIntervals[delivery_date]>=w",
              "        && MarketIntervals[delivery_date]<w+7",
              "        && (MarketIntervals[delivery_date]-w)*288+(MarketIntervals[delivery_hour]-1)*12+MarketIntervals[interval]-1<cap",
              "        && (ISBLANK(dow)||WEEKDAY(MarketIntervals[delivery_date],2)=dow)) RETURN AVERAGEX(observations,MarketIntervals[price_cad_mwh])"
            ],
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "a23ac5c3-7b98-43d4-b656-7eae1f38f6e2"
          },
          {
            "name": "Week Observed Demand Peak MW",
            "displayFolder": "Weekly summary",
            "expression": [
              "VAR w=[Selected Week] VAR cap=[Elapsed Week Hours]*12",
              "      VAR dow=SELECTEDVALUE('Calendar'[weekday_order])",
              "      VAR observations=FILTER(ALL(MarketIntervals),MarketIntervals[delivery_date]>=w",
              "        && MarketIntervals[delivery_date]<w+7",
              "        && (MarketIntervals[delivery_date]-w)*288+(MarketIntervals[delivery_hour]-1)*12+MarketIntervals[interval]-1<cap",
              "        && (ISBLANK(dow)||WEEKDAY(MarketIntervals[delivery_date],2)=dow)) RETURN MAXX(observations,MarketIntervals[demand_mw])"
            ],
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "70842cce-2dc8-440e-8927-4a4afced4dc6"
          },
          {
            "name": "Week Price Observations",
            "displayFolder": "Weekly summary",
            "expression": [
              "VAR w=[Selected Week] VAR cap=[Elapsed Week Hours]*12",
              "      VAR dow=SELECTEDVALUE('Calendar'[weekday_order])",
              "      VAR observations=FILTER(ALL(MarketIntervals),MarketIntervals[delivery_date]>=w",
              "        && MarketIntervals[delivery_date]<w+7",
              "        && (MarketIntervals[delivery_date]-w)*288+(MarketIntervals[delivery_hour]-1)*12+MarketIntervals[interval]-1<cap",
              "        && (ISBLANK(dow)||WEEKDAY(MarketIntervals[delivery_date],2)=dow)) RETURN COALESCE(COUNTX(observations,MarketIntervals[price_cad_mwh]),0)"
            ],
            "formatString": "#,0",
            "lineageTag": "39e2c1b0-4fb6-4c24-97cc-d2f8a2e4094d"
          },
          {
            "name": "Week Demand Observations",
            "displayFolder": "Weekly summary",
            "expression": [
              "VAR w=[Selected Week] VAR cap=[Elapsed Week Hours]*12",
              "      VAR dow=SELECTEDVALUE('Calendar'[weekday_order])",
              "      VAR observations=FILTER(ALL(MarketIntervals),MarketIntervals[delivery_date]>=w",
              "        && MarketIntervals[delivery_date]<w+7",
              "        && (MarketIntervals[delivery_date]-w)*288+(MarketIntervals[delivery_hour]-1)*12+MarketIntervals[interval]-1<cap",
