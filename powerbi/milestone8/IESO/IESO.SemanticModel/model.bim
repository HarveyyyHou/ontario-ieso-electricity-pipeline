        "partitions": [
          {
            "name": "PriceHourly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"SELECT delivery_date, delivery_hour, pricing_location,#(lf)          da_lmp_cad_per_mwh AS day_ahead_cad_mwh,#(lf)          CASE WHEN rt_intervals=12 THEN observed_rt_mean_cad_per_mwh END AS rt_mean_cad_mwh,#(lf)          rt_minus_da_cad_per_mwh AS spread_cad_mwh, rt_intervals#(lf)          FROM ieso_dev.gold.mart_hourly_price_spread#(lf)          WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__' AND pricing_location='__PRICING_LOCATION__' ORDER BY delivery_date,delivery_hour\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"PriceHourly\",Q4,{{\"delivery_date\", type date}, {\"delivery_hour\", Int64.Type}, {\"pricing_location\", type text}, {\"day_ahead_cad_mwh\", type number}, {\"rt_mean_cad_mwh\", type number}, {\"spread_cad_mwh\", type number}, {\"rt_intervals\", Int64.Type}})",
