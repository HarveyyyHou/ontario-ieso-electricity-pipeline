      {
        "name": "Coverage",
        "columns": [
          {
            "name": "delivery_date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "e730183c-266a-48ef-a5b2-91baa0ac4648",
            "sourceColumn": "delivery_date",
            "summarizeBy": "none"
          },
          {
            "name": "source",
            "dataType": "string",
            "lineageTag": "87a79179-11e4-4af5-887f-b3c5ef8041b0",
            "sourceColumn": "source",
            "summarizeBy": "none"
          },
          {
            "name": "observation_rows",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "82aebd7b-caaa-41cf-ac5e-35da53f5d53c",
            "sourceColumn": "observation_rows",
            "summarizeBy": "none"
          },
          {
            "name": "observed_slots",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "d253ea88-6b51-4ea7-a3e4-1acc13165b42",
            "sourceColumn": "observed_slots",
            "summarizeBy": "none"
          },
          {
            "name": "expected_slots",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "5ccfe55d-1465-469d-94dc-263d74be1f03",
            "sourceColumn": "expected_slots",
            "summarizeBy": "none"
          },
          {
            "name": "missing_slots",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "e4a2bc55-c4c0-4c63-8ba0-8c8d94397dc9",
            "sourceColumn": "missing_slots",
            "summarizeBy": "none"
          },
          {
            "name": "reported_entities",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "389eb24c-cb41-47e8-be9f-6b6e6d3aebca",
            "sourceColumn": "reported_entities",
            "summarizeBy": "none"
          },
          {
            "name": "coverage_note",
            "dataType": "string",
            "lineageTag": "4dc05d4a-8337-436b-bd83-976ce9560a17",
            "sourceColumn": "coverage_note",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "81ef5c25-f55f-4fa4-9c34-200296316cb7",
        "partitions": [
          {
            "name": "Coverage",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"WITH days AS (SELECT explode(sequence(DATE '__START__', DATE '__END__', INTERVAL 1 DAY)) AS delivery_date),#(lf)          sources AS (SELECT 'rt_lmp' AS source,288 AS expected_slots UNION ALL#(lf)            SELECT 'rt_totals',288 UNION ALL SELECT 'da_lmp',24 UNION ALL SELECT 'generator',24),#(lf)          observed AS (#(lf)            SELECT delivery_date,'rt_lmp' AS source,count(*) AS observation_rows,#(lf)              count(DISTINCT struct(delivery_hour,interval)) AS observed_slots,#(lf)              count(DISTINCT pricing_location) AS reported_entities#(lf)              FROM ieso_dev.gold.fact_rt_lmp_5m WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__' AND lmp IS NOT NULL GROUP BY delivery_date#(lf)            UNION ALL#(lf)            SELECT delivery_date,'rt_totals',count(*),#(lf)              count(DISTINCT struct(delivery_hour,interval)),cast(1 AS BIGINT)#(lf)              FROM ieso_dev.gold.fact_ontario_demand_5m WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__' AND ontario_demand IS NOT NULL GROUP BY delivery_date#(lf)            UNION ALL#(lf)            SELECT delivery_date,'da_lmp',count(*),count(DISTINCT delivery_hour),count(DISTINCT pricing_location)#(lf)              FROM ieso_dev.gold.fact_da_lmp_hourly WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__' AND lmp IS NOT NULL GROUP BY delivery_date#(lf)            UNION ALL#(lf)            SELECT delivery_date,'generator',count(*),count(DISTINCT delivery_hour),count(DISTINCT generator_name)#(lf)              FROM ieso_dev.gold.fact_generator_hourly WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__' GROUP BY delivery_date)#(lf)          SELECT d.delivery_date,s.source,coalesce(o.observation_rows,0) AS observation_rows,#(lf)            coalesce(o.observed_slots,0) AS observed_slots,s.expected_slots,#(lf)            s.expected_slots-coalesce(o.observed_slots,0) AS missing_slots,#(lf)            coalesce(o.reported_entities,0) AS reported_entities,#(lf)            CASE WHEN s.source IN ('rt_lmp','da_lmp') THEN 'Any-location time coverage; not all-location completeness'#(lf)                 WHEN s.source='generator' THEN 'Reported facility-hour coverage; measurements may still be missing'#(lf)                 ELSE 'Non-null Ontario demand interval coverage' END AS coverage_note#(lf)          FROM days d CROSS JOIN sources s LEFT JOIN observed o#(lf)          ON d.delivery_date=o.delivery_date AND s.source=o.source ORDER BY d.delivery_date,s.source\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"Coverage\",Q4,{{\"delivery_date\", type date}, {\"source\", type text}, {\"observation_rows\", Int64.Type}, {\"observed_slots\", Int64.Type}, {\"expected_slots\", Int64.Type}, {\"missing_slots\", Int64.Type}, {\"reported_entities\", Int64.Type}, {\"coverage_note\", type text}})",
                "        in Data"
              ],
              "type": "m"
            }
          }
        ]
      },
