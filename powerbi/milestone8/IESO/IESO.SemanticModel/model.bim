            "lineageTag": "f80a5e9f-9498-4c2a-bad5-18212a4d4e16",
            "sourceColumn": "archive_recovered",
            "summarizeBy": "none"
          },
          {
            "name": "without_kafka_delivery",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "c4c01c45-38b9-4141-8a0d-997db5289c70",
            "sourceColumn": "without_kafka_delivery",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "269421ab-5733-4685-8564-849c82a8a0bf",
        "partitions": [
          {
            "name": "HealthReports",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"WITH inv AS (SELECT from_json(cast(content AS STRING),#(lf)      'plan STRUCT<start_date:STRING,end_date:STRING,data_start_date:STRING,delivery_hour:INT,#(lf)       tasks:ARRAY<STRUCT<key:STRING,source:STRING,day:STRING,hour:INT>>>,#(lf)       reports ARRAY<STRUCT<key:STRING,source:STRING,day:STRING,hour:INT,expected_count:BIGINT,#(lf)       record:STRUCT<RowKey:STRING>>>') AS inventory#(lf)      FROM read_files('abfss://raw@iesodev001.dfs.core.windows.net/ieso/ops/m7/__BATCH__/inventory.json', format => 'binaryFile')), ranked AS (#(lf)          SELECT *,row_number() OVER (PARTITION BY batch_id ORDER BY completed_at DESC) AS n FROM (SELECT * FROM ieso_dev.ops.m7_runs WHERE batch_id='__BATCH__')),#(lf)          r AS (SELECT * FROM ranked WHERE n=1),#(lf)          sources AS (SELECT r.batch_id,explode(from_json(get_json_object(r.metrics,'$.real_time'),#(lf)            'MAP<STRING,STRUCT<reconcile:STRUCT<reports:ARRAY<STRUCT<report_id:STRING,#(lf)      expected:BIGINT,accepted_unique:BIGINT,rejected:BIGINT,valid_duplicate_deliveries:BIGINT,#(lf)      accepted_without_kafka_delivery:BIGINT>>,archive_recovered_reports:ARRAY<STRING>>>>')) AS (source,detail) FROM r),#(lf)          stats AS (SELECT batch_id,source,detail.reconcile.archive_recovered_reports AS recovered,#(lf)            explode(detail.reconcile.reports) AS report FROM sources),#(lf)          hourly AS (SELECT explode(from_json(get_json_object(metrics,'$.hourly'),'ARRAY<STRUCT<delivery_date:STRING,facts:STRUCT<da_lmp:STRUCT<rows:BIGINT>,#(lf)      generator:STRUCT<rows:BIGINT>>>>')) AS item FROM r),#(lf)          wanted AS (SELECT explode(inventory.reports) AS item FROM inv)#(lf)          SELECT '__BATCH__' AS batch_id,w.item.source,cast(w.item.day AS DATE) AS delivery_date,#(lf)            w.item.hour AS delivery_hour,coalesce(w.item.record.RowKey,w.item.key) AS report_id,#(lf)            w.item.expected_count AS expected_observations,#(lf)            CASE WHEN w.item.source='da_lmp' THEN h.item.facts.da_lmp.rows#(lf)                 WHEN w.item.source='generator' THEN h.item.facts.generator.rows#(lf)                 ELSE s.report.accepted_unique END AS accepted_unique,#(lf)            s.report.rejected,s.report.valid_duplicate_deliveries AS repeated_deliveries,#(lf)            CASE WHEN w.item.source NOT IN ('rt_lmp','rt_totals') THEN 'Not applicable to batch route'#(lf)              WHEN s.report.report_id IS NULL THEN 'Unknown'#(lf)              WHEN array_contains(s.recovered,s.report.report_id) THEN 'Yes' ELSE 'No' END AS archive_recovered,#(lf)            s.report.accepted_without_kafka_delivery AS without_kafka_delivery#(lf)          FROM wanted w LEFT JOIN stats s ON w.item.source=s.source AND w.item.record.RowKey=s.report.report_id#(lf)          LEFT JOIN hourly h ON w.item.day=h.item.delivery_date#(lf)          ORDER BY delivery_date,delivery_hour,source\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"HealthReports\",Q4,{{\"batch_id\", type text}, {\"source\", type text}, {\"delivery_date\", type date}, {\"delivery_hour\", Int64.Type}, {\"report_id\", type text}, {\"expected_observations\", Int64.Type}, {\"accepted_unique\", Int64.Type}, {\"rejected\", Int64.Type}, {\"repeated_deliveries\", Int64.Type}, {\"archive_recovered\", type text}, {\"without_kafka_delivery\", Int64.Type}})",
                "        in Data"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "HealthSteps",
