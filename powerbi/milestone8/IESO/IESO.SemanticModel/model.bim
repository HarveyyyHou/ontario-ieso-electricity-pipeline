        "partitions": [
          {
            "name": "FuelHourly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"SELECT delivery_date,delivery_hour,fuel_type,reported_facilities,#(lf)          facilities_with_output,reported_output_mw AS output_mw,#(lf)          reported_capability_mw AS capability_mw,reported_forecast_mw AS forecast_mw,#(lf)          reported_available_capacity_mw AS available_capacity_mw#(lf)          FROM ieso_dev.gold.mart_generation_fuel_hourly WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__'#(lf)          ORDER BY delivery_date,delivery_hour,fuel_type\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"FuelHourly\",Q4,{{\"delivery_date\", type date}, {\"delivery_hour\", Int64.Type}, {\"fuel_type\", type text}, {\"reported_facilities\", Int64.Type}, {\"facilities_with_output\", Int64.Type}, {\"output_mw\", type number}, {\"capability_mw\", type number}, {\"forecast_mw\", type number}, {\"available_capacity_mw\", type number}})",
                "        in Data"
              ],
              "type": "m"
            }
          }
        ]
