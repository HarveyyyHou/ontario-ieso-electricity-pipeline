            "summarizeBy": "none"
          },
          {
            "name": "scope_note",
            "dataType": "string",
            "lineageTag": "69ea2416-d8a5-4bbc-a266-ce0f572b8d38",
            "sourceColumn": "scope_note",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "13fb842f-b4fb-490f-b235-4206e80bb1b3",
        "partitions": [
          {
            "name": "HealthRuns",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"WITH inv AS (SELECT from_json(cast(content AS STRING),#(lf)      'plan STRUCT<start_date:STRING,end_date:STRING,data_start_date:STRING,delivery_hour:INT,#(lf)       tasks:ARRAY<STRUCT<key:STRING,source:STRING,day:STRING,hour:INT>>>,#(lf)       reports ARRAY<STRUCT<key:STRING,source:STRING,day:STRING,hour:INT,expected_count:BIGINT,#(lf)       record:STRUCT<RowKey:STRING>>>') AS inventory#(lf)      FROM read_files('abfss://raw@iesodev001.dfs.core.windows.net/ieso/ops/m7/__BATCH__/inventory.json', format => 'binaryFile')), ranked AS (#(lf)          SELECT *,row_number() OVER (PARTITION BY batch_id ORDER BY completed_at DESC) AS n FROM (SELECT * FROM ieso_dev.ops.m7_runs WHERE batch_id='__BATCH__')),#(lf)          r AS (SELECT * FROM ranked WHERE n=1)#(lf)          SELECT r.batch_id,r.job_run_id,r.adf_run_id,r.revision,r.completed_at AS spark_completed_utc,#(lf)            cast(get_json_object(r.metrics,'$.runtime_seconds') AS DOUBLE) AS spark_seconds,#(lf)            get_json_object(r.metrics,'$.passed') AS spark_passed,#(lf)            cast(i.inventory.plan.start_date AS DATE) AS requested_start,#(lf)            cast(i.inventory.plan.end_date AS DATE) AS requested_end,#(lf)            cast(i.inventory.plan.data_start_date AS DATE) AS data_start,#(lf)            i.inventory.plan.delivery_hour AS selected_delivery_hour,#(lf)            size(i.inventory.plan.tasks) AS expected_reports,size(i.inventory.reports) AS received_reports,#(lf)            'Unknown - check ADF/control record' AS final_batch_status,#(lf)            cast(NULL AS TIMESTAMP) AS final_batch_completed_utc,#(lf)            'Sealed inventory and successful Spark records only; not a complete attempt/failure history' AS scope_note#(lf)          FROM r CROSS JOIN inv i\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"HealthRuns\",Q4,{{\"batch_id\", type text}, {\"job_run_id\", type text}, {\"adf_run_id\", type text}, {\"revision\", type text}, {\"spark_completed_utc\", type datetime}, {\"spark_seconds\", type number}, {\"spark_passed\", type text}, {\"requested_start\", type date}, {\"requested_end\", type date}, {\"data_start\", type date}, {\"selected_delivery_hour\", Int64.Type}, {\"expected_reports\", Int64.Type}, {\"received_reports\", Int64.Type}, {\"final_batch_status\", type text}, {\"final_batch_completed_utc\", type datetime}, {\"scope_note\", type text}})",
                "        in Data"
              ],
              "type": "m"
            }
          }
        ]
      },
