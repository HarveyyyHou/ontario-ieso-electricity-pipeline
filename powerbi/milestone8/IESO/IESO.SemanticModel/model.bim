        "partitions": [
          {
            "name": "MarketIntervals",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"SELECT delivery_date, delivery_hour, interval,#(lf)          interval_start_utc, interval_end_utc, observed_lmp_locations,#(lf)          avg_location_lmp_cad_per_mwh AS price_cad_mwh,#(lf)          min_location_lmp_cad_per_mwh AS min_price_cad_mwh,#(lf)          max_location_lmp_cad_per_mwh AS max_price_cad_mwh,#(lf)          ontario_demand_mw AS demand_mw#(lf)          FROM ieso_dev.gold.mart_market_overview WHERE delivery_date BETWEEN DATE '__START__' AND DATE '__END__'#(lf)          ORDER BY delivery_date,delivery_hour,interval\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"MarketIntervals\",Q4,{{\"delivery_date\", type date}, {\"delivery_hour\", Int64.Type}, {\"interval\", Int64.Type}, {\"interval_start_utc\", type datetime}, {\"interval_end_utc\", type datetime}, {\"observed_lmp_locations\", Int64.Type}, {\"price_cad_mwh\", type number}, {\"min_price_cad_mwh\", type number}, {\"max_price_cad_mwh\", type number}, {\"demand_mw\", type number}})",
                "        in Data"
              ],
