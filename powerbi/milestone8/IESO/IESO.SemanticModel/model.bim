        "lineageTag": "65220bb3-3d31-4fe4-8527-56e1e7c33550",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "          Template = \"WITH days AS (SELECT explode(sequence(DATE '__START__', DATE '__END__', INTERVAL 1 DAY)) AS delivery_date)#(lf)          SELECT delivery_date, cast(date_trunc('week',delivery_date) AS DATE) AS week_start,#(lf)          date_add(cast(date_trunc('week',delivery_date) AS DATE),6) AS week_end,#(lf)          pmod(dayofweek(delivery_date)+5,7)+1 AS weekday_order,#(lf)          date_format(delivery_date,'EEEE') AS weekday FROM days\",",
                "          Q1 = Text.Replace(Template,\"__START__\",Date.ToText(pStartDate,\"yyyy-MM-dd\")),",
                "          Q2 = Text.Replace(Q1,\"__END__\",Date.ToText(pEndDate,\"yyyy-MM-dd\")),",
                "          Q3 = Text.Replace(Q2,\"__PRICING_LOCATION__\",Text.Replace(pLocation,\"'\",\"''\")),",
                "          Q4 = if Text.Length(pBatchId)=24 and Text.Length(Text.Select(pBatchId,{\"0\"..\"9\",\"a\"..\"f\"}))=24",
                "               then Text.Replace(Q3,\"__BATCH__\",pBatchId) else error \"Invalid M7 batch ID\",",
                "          Data = fnLoad(\"Calendar\",Q4,{{\"delivery_date\", type date}, {\"week_start\", type date}, {\"week_end\", type date}, {\"weekday_order\", Int64.Type}, {\"weekday\", type text}})",
                "        in Data"
              ],
              "type": "m"
            }
          }
        ]
      },
